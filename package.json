{
  "name": "ujira",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "budget:check": "node scripts/check-bundle-budget.ts apps/dashboard 250",
    "build": "node scripts/check-workspace-scripts.ts && node scripts/gate.ts build",
    "db:check": "node scripts/check-migrations.ts",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:rehearse": "node scripts/db-rehearse.ts",
    "db:roundtrip": "node scripts/db-schema.ts roundtrip",
    "db:snapshot": "node scripts/db-schema.ts snapshot",
    "db:types": "node scripts/db-types.ts",
    "format": "prettier --config .prettierrc.json --no-editorconfig --ignore-path .prettierignore --write .",
    "format:check": "prettier --config .prettierrc.json --no-editorconfig --ignore-path .prettierignore --check .",
    "invisible:check": "node scripts/check-invisible-characters.ts",
    "licenses:check": "node scripts/check-licenses.ts",
    "lint": "node scripts/check-workspace-scripts.ts && node scripts/lint.ts --max-warnings 0",
    "metadata:check": "node scripts/check-embedded-metadata.ts",
    "metadata:strip": "node scripts/strip-embedded-metadata.ts",
    "page:report": "node scripts/check-page-performance.ts apps/dashboard/lighthouserc.json apps/dashboard/.lighthouseci",
    "test": "vitest run --coverage --configLoader native",
    "typecheck": "node scripts/check-workspace-scripts.ts && node scripts/gate.ts typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
