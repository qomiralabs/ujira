# The one variable the payouts worker reads beyond the UJIRA_DB_* variables, which
# are documented in packages/db/.env.example. The worker logs in as ujira_worker on
# UJIRA_DB_WORKER_URL and as ujira_app on UJIRA_DB_APP_URL, and refuses to start if
# either is another login.

# Jobs a pool runs at once. It must stay below UJIRA_DB_WORKER_POOL_SIZE, because the
# queue's listener holds one connection for as long as the pool runs. Handlers use
# the app pool, so a job does not hold a worker connection while it runs.
# default: UJIRA_WORKER_CONCURRENCY=3

# Only for the install step, `pnpm --filter @ujira/payouts worker:install`, and never
# on a running service. The platform admin, who alone can grant CREATE on the database
# for the length of the install. Passwords come from the secret manager at deploy time.
# UJIRA_DB_ADMIN_URL=postgresql://postgres:REPLACE_ME@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
