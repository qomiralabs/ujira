{
  "name": "@ujira/db",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./key-manager": {
      "types": "./dist/key-manager/index.d.ts",
      "default": "./dist/key-manager/index.js"
    },
    "./key-manager/contract": {
      "types": "./dist/key-manager/contract.d.ts",
      "default": "./dist/key-manager/contract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "migrate:up": "node ../../scripts/db-migrate.ts up",
    "migrate:down": "node ../../scripts/db-migrate.ts down",
    "db:types": "node ../../scripts/db-types.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/pg": "8.23.1",
    "@ujira/router": "workspace:*",
    "@ujira/api-schema": "workspace:*",
    "fast-check": "4.10.2",
    "kysely-codegen": "0.20.0",
    "node-pg-migrate": "9.0.0"
  },
  "dependencies": {
    "@ujira/core": "workspace:*",
    "kysely": "0.29.6",
    "pg": "8.23.1"
  }
}
