{
  "name": "@ujira/signer",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "default": "./dist/service/index.js"
    },
    "./aws-kms": {
      "types": "./dist/aws-kms/index.d.ts",
      "default": "./dist/aws-kms/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1152.0",
    "@hono/node-server": "2.1.5",
    "@noble/curves": "2.4.0",
    "@ujira/chain-adapter": "workspace:*",
    "hono": "4.13.13",
    "zod": "4.6.7"
  }
}
