{
  "name": "@ujira/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run --coverage",
    "openapi": "UJIRA_WRITE_OPENAPI=1 vitest run src/openapi.test.ts",
    "openapi:check": "vitest run src/openapi.test.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@ujira/api-schema": "workspace:*",
    "@ujira/chain-adapter": "workspace:*",
    "@ujira/core": "workspace:*",
    "@ujira/db": "workspace:*",
    "@ujira/identity": "workspace:*",
    "@ujira/receipts": "workspace:*",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
