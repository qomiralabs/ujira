                  },
                  "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
                  "nonce": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "signature": { "type": "string", "minLength": 1, "maxLength": 2048 },
                  "signer": { "type": "string", "pattern": "^[A-Za-z0-9]{1,128}$" }
