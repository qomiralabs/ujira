  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "detail": { "type": "string", "maxLength": 1000 },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_FILTER",
              "INVALID_CURSOR",
              "LIMIT_OUT_OF_RANGE",
              "INVALID_AMOUNT",
              "INVALID_REQUEST",
              "IDEMPOTENCY_KEY_INVALID",
              "WEBHOOK_SIGNATURE_INVALID",
              "WEBHOOK_PAYLOAD_INVALID",
              "WEBHOOK_REJECTED",
              "TOKEN_MALFORMED",
              "TOKEN_INVALID",
              "TOKEN_ENVIRONMENT_MISMATCH",
              "EMBED_TOKEN_INVALID",
              "INSUFFICIENT_SCOPE",
              "ORIGIN_NOT_ALLOWED",
              "EMBED_SCOPE_VIOLATION",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "IDEMPOTENCY_IN_PROGRESS",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "DESTINATION_INVALID",
              "MANDATE_REFUSED",
              "QUOTE_UNAVAILABLE",
              "WALLET_PROOF_INVALID",
              "WALLET_PROOF_EXPIRED",
              "WALLET_SIGNER_NOT_AUTHORIZED",
              "DESTINATION_NOT_RECEIVABLE",
              "IDEMPOTENCY_KEY_REUSED",
              "RATE_LIMITED",
              "INTERNAL",
              "DB_UNAVAILABLE",
              "CHAIN_UNAVAILABLE",
              "REQUEST_TIMEOUT",
              "WEBHOOK_UNAVAILABLE"
            ]
          },
          "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
          "errors": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string", "minLength": 1, "maxLength": 200 },
                "code": {
                  "type": "string",
                  "enum": [
                    "unknown_field",
                    "invalid_value",
                    "unsupported_operator",
                    "range_inverted",
                    "repeated_key",
                    "currency_required"
                  ]
                }
              },
              "required": ["field", "code"],
              "additionalProperties": false
            }
          }
        },
        "required": ["type", "title", "status", "code", "requestId"],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": { "status": { "type": "string", "const": "ok" } },
        "required": ["status"],
        "additionalProperties": false
      },
      "SelfWebhookAck": {
        "type": "object",
        "properties": {
          "result": { "type": "string", "enum": ["applied", "duplicate", "stale", "ignored"] }
        },
        "required": ["result"],
        "additionalProperties": false
      },
      "WalletChallenge": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "message": { "type": "string", "minLength": 1 },
          "nonce": { "type": "string", "minLength": 1 },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["challengeId", "message", "nonce", "expiresAt"],
        "additionalProperties": false
      },
      "WalletProofAccepted": {
        "type": "object",
        "properties": {
          "verificationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "level": { "type": "string", "const": "wallet_signature" },
          "signerKey": { "type": "string", "minLength": 1 }
        },
        "required": ["verificationId", "level", "signerKey"],
        "additionalProperties": false
      },
      "OpenApiDocument": {
        "type": "object",
        "properties": {
          "openapi": { "type": "string", "const": "3.1.1" },
          "info": {
            "type": "object",
            "properties": { "title": { "type": "string" }, "version": { "type": "string" } },
            "required": ["title", "version"],
            "additionalProperties": {}
          },
          "paths": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": {}
          },
          "components": {
            "type": "object",
            "propertyNames": { "type": "string" },
            "additionalProperties": {}
          }
        },
        "required": ["openapi", "info", "paths", "components"],
        "additionalProperties": {}
      }
    },
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer" } }
  }
}
