    "/v1/recipients/{id}/methods/{methodId}/wallet-challenges": {
      "post": {
        "operationId": "createWalletChallenge",
        "summary": "Issue a challenge for a recipient to prove they control a payout destination",
        "security": [{ "bearer": [] }],
        "x-ujira-scope": "recipients:write",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          {
            "name": "methodId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Unique per write. A retry with the same key and the same request gets the first answer for 7 days; the same key on a different request is refused.",
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,255}$" }
          }
        ],
        "responses": {
          "201": {
            "description": "OK",
            "headers": {
              "Request-Id": { "schema": { "type": "string" } },
              "RateLimit-Limit": { "schema": { "type": "string" } },
              "RateLimit-Remaining": { "schema": { "type": "string" } },
              "RateLimit-Reset": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/WalletChallenge" } }
            }
          },
          "400": {
            "description": "INVALID_FILTER: The filter is not valid. INVALID_CURSOR: The cursor is not valid for this list. LIMIT_OUT_OF_RANGE: The limit must be from 1 to 200. INVALID_AMOUNT: The amount is not an integer count of minor units. INVALID_REQUEST: The request is not valid. IDEMPOTENCY_KEY_INVALID: The Idempotency-Key header is missing or not valid. WEBHOOK_SIGNATURE_INVALID: The webhook signature is not valid. WEBHOOK_PAYLOAD_INVALID: The webhook body is not valid. WEBHOOK_REJECTED: The webhook is for another environment or flow",
            "headers": { "Request-Id": { "schema": { "type": "string" } } },
            "content": {
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
            }
          },
          "401": {
            "description": "TOKEN_MALFORMED: The API key is missing or malformed. TOKEN_INVALID: The API key is not valid. TOKEN_ENVIRONMENT_MISMATCH: The API key is for another environment. EMBED_TOKEN_INVALID: The embed session is not valid",
            "headers": { "Request-Id": { "schema": { "type": "string" } } },
            "content": {
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
            }
          },
          "403": {
            "description": "INSUFFICIENT_SCOPE: The API key lacks the scope this route needs. ORIGIN_NOT_ALLOWED: The request origin is not allowed. EMBED_SCOPE_VIOLATION: The embed session cannot reach this route",
            "headers": { "Request-Id": { "schema": { "type": "string" } } },
            "content": {
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
            }
          },
          "404": {
            "description": "NOT_FOUND: Not found",
            "headers": { "Request-Id": { "schema": { "type": "string" } } },
            "content": {
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
            }
          },
          "409": {
            "description": "IDEMPOTENCY_IN_PROGRESS: A request with this Idempotency-Key is still running",
            "headers": {
              "Request-Id": { "schema": { "type": "string" } },
              "Retry-After": { "schema": { "type": "string" } }
            },
            "content": {
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
            }
          },
          "422": {
            "description": "DESTINATION_INVALID: The destination cannot receive this payout. MANDATE_REFUSED: The mandate does not allow this. QUOTE_UNAVAILABLE: No quote is available for this payout right now. WALLET_PROOF_INVALID: The wallet proof is not valid. WALLET_PROOF_EXPIRED: The wallet proof challenge has expired. WALLET_SIGNER_NOT_AUTHORIZED: That key cannot sign for this wallet. DESTINATION_NOT_RECEIVABLE: This destination cannot receive a payout yet. IDEMPOTENCY_KEY_REUSED: This Idempotency-Key was used for a different request",
            "headers": { "Request-Id": { "schema": { "type": "string" } } },
            "content": {
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
            }
          },
          "429": {
            "description": "RATE_LIMITED: Too many requests",
            "headers": {
              "Request-Id": { "schema": { "type": "string" } },
              "Retry-After": { "schema": { "type": "string" } },
              "RateLimit-Limit": { "schema": { "type": "string" } },
              "RateLimit-Remaining": { "schema": { "type": "string" } },
              "RateLimit-Reset": { "schema": { "type": "string" } }
            },
            "content": {
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
            }
          },
          "500": {
            "description": "INTERNAL: Something went wrong on our side",
            "headers": { "Request-Id": { "schema": { "type": "string" } } },
            "content": {
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
            }
          },
          "503": {
            "description": "DB_UNAVAILABLE: The service is temporarily unavailable. CHAIN_UNAVAILABLE: The network is temporarily unavailable. REQUEST_TIMEOUT: The request took too long. WEBHOOK_UNAVAILABLE: This webhook cannot be received right now",
            "headers": {
              "Request-Id": { "schema": { "type": "string" } },
              "Retry-After": { "schema": { "type": "string" } }
            },
            "content": {
              "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } }
            }
          }
        }
      }
    },
    "/v1/recipients/{id}/methods/{methodId}/wallet-proofs": {
      "post": {
        "operationId": "submitWalletProof",
