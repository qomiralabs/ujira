{
  "$description": "Design system tokens layered on the brand colours. A colour is a reference into the brand tokens, written {core.name}, {neutral.name}, {status.name.shade} or {mode.name} for the current mode. A literal hex is allowed only for a value the brand palette does not have: the status extensions below and data visualisation steps.",
  "status": {
    "blocked": {
      "dark-text": "#FCA5A5"
    }
  },
  "mode": {
    "light": {
      "blocked": "{status.blocked.text}",
      "paid-fill": "{status.paid.fill}",
      "waiting-fill": "{status.waiting.fill}",
      "blocked-fill": "{status.blocked.fill}"
    },
    "dark": {
      "blocked": "{status.blocked.dark-text}",
      "paid-fill": "{status.paid.dark}",
      "waiting-fill": "{status.waiting.dark}",
      "blocked-fill": "{status.blocked.dark}"
    }
  },
  "density": {
    "row": "44px",
    "row-compact": "36px"
  },
  "radius": {
    "control": "6px",
    "card": "10px",
    "overlay": "14px"
  },
  "focus": {
    "width": "2px",
    "offset": "2px",
    "color": "{core.saffron}",
    "inner": "{core.teal-ink}"
  },
  "shadow": {
    "overlay": {
      "x": "0px",
      "y": "8px",
      "blur": "24px",
      "color": "{core.teal-ink}",
      "alpha": 0.16
    }
  },
  "motion": {
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-settle": "cubic-bezier(0.34, 1.3, 0.64, 1)",
    "arrive": "400ms"
  },
  "font": {
    "display": {
      "face": "Nunito",
      "variable": "--ujira-font-nunito",
      "fallback": ["ui-rounded", "system-ui", "sans-serif"]
    },
    "sans": {
      "face": "Inter",
      "variable": "--ujira-font-inter",
      "fallback": ["ui-sans-serif", "system-ui", "sans-serif"]
    },
    "mono": {
      "face": "JetBrains Mono",
      "variable": "--ujira-font-jetbrains-mono",
      "signs": {
        "face": "Noto Sans Mono",
        "file": "noto-sans-mono-currency-signs.woff2",
        "weight": "100 900",
        "unicodeRange": ["U+20A6", "U+20B1", "U+20B5", "U+20B9"]
      },
      "fallback": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
    }
  },
  "type": {
    "display-xl": {
      "family": "display",
      "size": 80,
      "lineHeight": 1,
      "tracking": "-0.03em",
      "weight": 800
    },
    "display-l": {
      "family": "display",
      "size": 56,
      "lineHeight": 1.05,
      "tracking": "-0.025em",
      "weight": 800
    },
    "display-m": {
      "family": "display",
      "size": 40,
      "lineHeight": 1.1,
      "tracking": "-0.02em",
      "weight": 800
    },
    "display-s": {
      "family": "display",
      "size": 28,
      "lineHeight": 1.2,
      "tracking": "-0.01em",
      "weight": 800
    },
    "title": {
      "family": "sans",
      "size": 20,
      "lineHeight": 1.3,
      "tracking": "-0.01em",
      "weight": 600
    },
    "body-l": {
      "family": "sans",
      "size": 18,
      "lineHeight": 1.6,
      "tracking": "0em",
      "weight": 400
    },
    "body": {
      "family": "sans",
      "size": 16,
      "lineHeight": 1.6,
      "tracking": "0em",
      "weight": 400
    },
    "body-s": {
      "family": "sans",
      "size": 14,
      "lineHeight": 1.55,
      "tracking": "0em",
      "weight": 400
    },
    "amount-xl": {
      "family": "mono",
      "size": 40,
      "lineHeight": 1.1,
      "tracking": "-0.01em",
      "weight": 500
    },
    "amount-l": {
      "family": "mono",
      "size": 28,
      "lineHeight": 1.15,
      "tracking": "-0.01em",
      "weight": 500
    },
    "data": {
      "family": "mono",
      "size": 14,
      "lineHeight": 1.4,
      "tracking": "0em",
      "weight": 400
    },
    "label": {
      "family": "mono",
      "size": 12,
      "lineHeight": 1.2,
      "tracking": "0.14em",
      "weight": 500
    }
  },
  "viz": {
    "light": {
      "categorical": ["{core.teal}", "#5C8F9A", "#5B574F", "#8B7E6A"],
      "sequential": ["#5C8F9A", "#427785", "#2C606F", "{core.teal}", "{core.teal-ink}"],
      "highlight": "{core.saffron}",
      "highlight-stroke": "{core.saffron-deep}",
      "paid": "{status.paid.fill}",
      "waiting": "{status.waiting.fill}",
      "waiting-stroke": "{status.waiting.text}",
      "blocked": "{status.blocked.fill}",
      "grid": "{mode.rule}",
      "axis": "{mode.text-secondary}",
      "tooltip": "{mode.surface}",
      "tooltip-rule": "{mode.rule}",
      "tooltip-text": "{mode.text}"
    },
    "dark": {
      "categorical": ["{core.cream}", "{neutral.mist-300}", "#9A9992", "#C9C0B0"],
      "sequential": ["#729BA6", "#8FB1B9", "#AFC6CC", "#D1DDDE", "{core.cream}"],
      "highlight": "{core.saffron}",
      "highlight-stroke": "{core.saffron}",
      "paid": "{status.paid.dark}",
      "waiting": "{status.waiting.dark}",
      "waiting-stroke": "{status.waiting.dark}",
      "blocked": "{status.blocked.dark}",
      "grid": "{mode.rule}",
      "axis": "{mode.text-secondary}",
      "tooltip": "{mode.surface}",
      "tooltip-rule": "{mode.rule}",
      "tooltip-text": "{mode.text}"
    }
  }
}
