    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "tokens": "node tokens/build.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  }
