{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    // The brand generator, the bundler and the screenshot script run directly
    // under Node type stripping, which needs the real .ts extension on
    // relative imports. Only tokens/ and tools/ use it; src/ keeps .js so the
    // build output resolves.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tokens", "tools", "e2e", "playwright.config.ts"]
}
